 "netClasses": [
  {
   "name": "VBAT",
   "nets": [
    "VBAT"
   ],
   "track": 0.4,
   "clearance": 0.15,
   "currentA": 1.2,
   "why": "the two BECs' input: 5 V x 2 A + 10 V x 1 A (a DJI O3) at 90 % is 1.1 A from a 6S pack, 1.6 A from 4S. 0.4 mm of 1 oz outer copper carries 1.23 A at a 10 C rise (IPC-2221), 1.67 A at 20 C. The default via, not a bigger class via: Freerouting's fanout used the default padstack on these nets and KiCad's SES import then gave it the class drill (0.45 / 0.3 mm, a 0.075 mm annular ring), 2026-10-05"
  },
  {
   "name": "BEC",
   "nets": [
    "5V",
    "10V"
   ],
   "track": 0.4,
   "clearance": 0.15,
   "currentA": 1.2,
   "why": "5 V feeds the receiver, GPS, LED strip and both LDOs (and is the In3 plane, so its tracks are only pad escapes); 10 V the VTX (about 1 A for a DJI O3)"
  }
 ],
 "board": {
  "width": 40.0,
  "height": 40.0,
  "corner_radius": 3.0,
  "layers": 6,
